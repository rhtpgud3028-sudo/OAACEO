// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © ICT Trading Indicator V2 - "KSH's Personal ICT Strategy"
// 핵심: 최소 2개 근거 + 대추세 분석 필수 / 미충족 시 OB 드로잉 금지

//@version=5
indicator("ICT Indicator V2 - KSH", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// 핵심 설정
// ═══════════════════════════════════════════════════════════════════════════════
grp_core = "═══ 핵심 설정 ═══"
min_confirmations = input.int(2, "최소 근거 개수", minval=1, maxval=5, group=grp_core)
require_htf_trend = input.bool(true, "HTF 추세 확인 필수", group=grp_core)
require_fvg = input.bool(true, "FVG 필수 (OB 유효조건)", group=grp_core)
require_bos_choch = input.bool(true, "BOS/CHoCH 필수", group=grp_core)

// ═══════════════════════════════════════════════════════════════════════════════
// HTF 설정 (1D)
// ═══════════════════════════════════════════════════════════════════════════════
grp_htf = "═══ HTF 대추세 (1D) ═══"
htf_tf = input.timeframe("D", "HTF Timeframe", group=grp_htf)
htf_lookback = input.int(20, "추세 판단 기간", minval=5, maxval=50, group=grp_htf)
show_htf_levels = input.bool(true, "주요 지지/저항 표시", group=grp_htf)

// ═══════════════════════════════════════════════════════════════════════════════
// OB 설정
// ═══════════════════════════════════════════════════════════════════════════════
grp_ob = "═══ Order Block ═══"
show_1h_ob = input.bool(true, "1H OB 표시 (노란색)", group=grp_ob)
show_5m_ob = input.bool(true, "5m/15m OB 표시 (보라색)", group=grp_ob)
ob_extend_bars = input.int(50, "OB 연장 캔들 수", minval=10, maxval=200, group=grp_ob)
mark_used_ob = input.bool(true, "사용된 OB 표시 (주황색)", group=grp_ob)

// ═══════════════════════════════════════════════════════════════════════════════
// FVG 설정
// ═══════════════════════════════════════════════════════════════════════════════
grp_fvg = "═══ Fair Value Gap ═══"
show_fvg = input.bool(true, "FVG 표시 (청록색)", group=grp_fvg)
fvg_after_bos = input.bool(true, "BOS/CHoCH 이후 FVG만 표시", group=grp_fvg)

// ═══════════════════════════════════════════════════════════════════════════════
// Killzone (AMD) 설정
// ═══════════════════════════════════════════════════════════════════════════════
grp_killzone = "═══ Killzone (AMD) ═══"
show_killzone = input.bool(true, "Killzone 배경 표시", group=grp_killzone)
asia_start = input.int(1, "Asia Start (UTC)", minval=0, maxval=23, group=grp_killzone)
asia_end = input.int(5, "Asia End (UTC)", minval=0, maxval=23, group=grp_killzone)
london_start = input.int(7, "London Start (UTC)", minval=0, maxval=23, group=grp_killzone)
london_end = input.int(10, "London End (UTC)", minval=0, maxval=23, group=grp_killzone)
ny_start = input.int(13, "NY Start (UTC)", minval=0, maxval=23, group=grp_killzone)
ny_end = input.int(17, "NY End (UTC)", minval=0, maxval=23, group=grp_killzone)

// ═══════════════════════════════════════════════════════════════════════════════
// 진입 시그널 설정
// ═══════════════════════════════════════════════════════════════════════════════
grp_signal = "═══ 진입 시그널 ═══"
show_engulfing = input.bool(true, "인걸핑 캔들 표시", group=grp_signal)
show_entry_signal = input.bool(true, "진입 시그널 표시", group=grp_signal)

// ═══════════════════════════════════════════════════════════════════════════════
// 색상 설정
// ═══════════════════════════════════════════════════════════════════════════════
grp_color = "═══ 색상 ═══"
color_1h_ob = input.color(color.new(color.yellow, 70), "1H OB", group=grp_color)
color_5m_ob = input.color(color.new(color.purple, 70), "5m/15m OB", group=grp_color)
color_used_ob = input.color(color.new(color.orange, 70), "사용된 OB", group=grp_color)
color_bb = input.color(color.new(color.blue, 70), "Breaker Block", group=grp_color)
color_fvg = input.color(color.new(color.teal, 75), "FVG", group=grp_color)

// ═══════════════════════════════════════════════════════════════════════════════
// 변수 초기화
// ═══════════════════════════════════════════════════════════════════════════════
var int htf_trend = 0  // 1=상승, -1=하락, 0=횡보
var int confirmation_count = 0
var float htf_resistance = na
var float htf_support = na
var bool bos_detected = false
var bool choch_detected = false
var bool fvg_detected = false

// Swing 변수
var float last_swing_high = na
var float last_swing_low = na
pivot_len = 3
pivot_high_val = ta.pivothigh(high, pivot_len, pivot_len)
pivot_low_val = ta.pivotlow(low, pivot_len, pivot_len)

if not na(pivot_high_val)
    last_swing_high := pivot_high_val
if not na(pivot_low_val)
    last_swing_low := pivot_low_val

// ═══════════════════════════════════════════════════════════════════════════════
// HTF 추세 분석 (1D)
// ═══════════════════════════════════════════════════════════════════════════════
[htf_h, htf_l, htf_c, htf_o] = request.security(syminfo.tickerid, htf_tf, [high, low, close, open])

htf_highest = ta.highest(htf_h, htf_lookback)
htf_lowest = ta.lowest(htf_l, htf_lookback)
htf_mid = (htf_highest + htf_lowest) / 2

// 추세 판단: HH-HL = 상승, LH-LL = 하락
htf_bullish = htf_c > htf_mid and htf_c > htf_c[1] and htf_c[1] > htf_c[2]
htf_bearish = htf_c < htf_mid and htf_c < htf_c[1] and htf_c[1] < htf_c[2]

htf_trend := htf_bullish ? 1 : htf_bearish ? -1 : 0

// 주요 지지/저항
htf_resistance := htf_highest
htf_support := htf_lowest

// 유격 (먹을 거리) 계산
distance_to_resistance = htf_resistance - close
distance_to_support = close - htf_support
distance_percent = htf_trend == 1 ? (distance_to_resistance / close * 100) : (distance_to_support / close * 100)

// ═══════════════════════════════════════════════════════════════════════════════
// Killzone (AMD) 감지
// ═══════════════════════════════════════════════════════════════════════════════
current_hour = hour(time, "UTC")
is_asia = current_hour >= asia_start and current_hour < asia_end
is_london = current_hour >= london_start and current_hour < london_end
is_ny = current_hour >= ny_start and current_hour < ny_end

killzone_name = is_asia ? "A" : is_london ? "M" : is_ny ? "D" : "-"
is_killzone = is_asia or is_london or is_ny

// 배경색
asia_color = color.new(color.gray, 93)
london_color = color.new(color.orange, 93)
ny_color = color.new(color.blue, 93)

bgcolor(show_killzone and is_asia ? asia_color : na, title="Asia Session")
bgcolor(show_killzone and is_london ? london_color : na, title="London Session")
bgcolor(show_killzone and is_ny ? ny_color : na, title="NY Session")

// ═══════════════════════════════════════════════════════════════════════════════
// BOS / CHoCH 감지
// ═══════════════════════════════════════════════════════════════════════════════
// BOS: 추세 방향으로 구조 돌파
bos_bull = close > nz(last_swing_high, high) and htf_trend == 1
bos_bear = close < nz(last_swing_low, low) and htf_trend == -1

// CHoCH: 반대 방향으로 구조 돌파 (추세 전환)
choch_bull = close > nz(last_swing_high, high) and htf_trend <= 0
choch_bear = close < nz(last_swing_low, low) and htf_trend >= 0

bos_detected := bos_bull or bos_bear
choch_detected := choch_bull or choch_bear

// BOS/CHoCH 라벨
if bos_bull
    label.new(bar_index, low, "BOS", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny)
if bos_bear
    label.new(bar_index, high, "BOS", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)
if choch_bull
    label.new(bar_index, low, "CHoCH", style=label.style_label_up, color=color.teal, textcolor=color.white, size=size.small)
if choch_bear
    label.new(bar_index, high, "CHoCH", style=label.style_label_down, color=color.maroon, textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// FVG 감지 (BOS/CHoCH 이후만)
// ═══════════════════════════════════════════════════════════════════════════════
bull_fvg_raw = low > high[2]
bear_fvg_raw = high < low[2]

// BOS/CHoCH 이후 FVG만 유효
var bool recent_structure_break = false
if bos_detected or choch_detected
    recent_structure_break := true

// 10봉 이내 구조 돌파 확인
structure_break_recent = ta.barssince(bos_detected or choch_detected) < 10

bull_fvg = bull_fvg_raw and (not fvg_after_bos or structure_break_recent)
bear_fvg = bear_fvg_raw and (not fvg_after_bos or structure_break_recent)

fvg_detected := bull_fvg or bear_fvg

// FVG 표시
if show_fvg and bull_fvg
    fvg_top = low
    fvg_bottom = high[2]
    box.new(bar_index - 1, fvg_top, bar_index + 20, fvg_bottom, bgcolor=color_fvg, border_color=color.teal, border_width=1)
    label.new(bar_index, fvg_bottom, "FVG", style=label.style_label_up, color=color.teal, textcolor=color.white, size=size.tiny)

if show_fvg and bear_fvg
    fvg_top = low[2]
    fvg_bottom = high
    box.new(bar_index - 1, fvg_top, bar_index + 20, fvg_bottom, bgcolor=color_fvg, border_color=color.teal, border_width=1)
    label.new(bar_index, fvg_top, "FVG", style=label.style_label_down, color=color.teal, textcolor=color.white, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// OB 감지 (4가지 필수 조건 충족 시에만)
// ═══════════════════════════════════════════════════════════════════════════════
// OB 조건:
// 1. Imbalance (장대양/음봉)
// 2. 구조붕괴 (BOS or CHoCH)
// 3. 비효율성 (FVG 동반)
// 4. Unmitigated (첫 번째 되돌림)

atr_val = ta.atr(14)

// Imbalance 감지 (장대양/음봉)
bull_imbalance = close > open and (close - open) > atr_val * 1.5
bear_imbalance = close < open and (open - close) > atr_val * 1.5

// Bullish OB: 장대양봉 직전의 하락캔들
bull_ob_candle = close[1] < open[1] and bull_imbalance
// Bearish OB: 장대음봉 직전의 상승캔들
bear_ob_candle = close[1] > open[1] and bear_imbalance

// 근거 카운터
confirmation_count := 0

// 근거 1: HTF 추세 확인
if htf_trend != 0
    confirmation_count += 1

// 근거 2: BOS or CHoCH
if bos_detected or choch_detected or structure_break_recent
    confirmation_count += 1

// 근거 3: FVG 동반
if fvg_detected or bull_fvg or bear_fvg
    confirmation_count += 1

// 근거 4: Killzone 내
if is_killzone
    confirmation_count += 1

// 근거 5: Imbalance
if bull_imbalance or bear_imbalance
    confirmation_count += 1

// OB 유효성 판단 (최소 근거 충족 시에만)
valid_bull_ob = bull_ob_candle and confirmation_count >= min_confirmations
valid_bear_ob = bear_ob_candle and confirmation_count >= min_confirmations

// ta.barssince를 미리 계산 (if 블록 밖에서)
bars_since_bull_fvg = ta.barssince(bull_fvg_raw)
bars_since_bear_fvg = ta.barssince(bear_fvg_raw)
fvg_bull_recent = bull_fvg or bars_since_bull_fvg < 5
fvg_bear_recent = bear_fvg or bars_since_bear_fvg < 5

// HTF 추세 필수 체크
if require_htf_trend
    valid_bull_ob := valid_bull_ob and htf_trend >= 0
    valid_bear_ob := valid_bear_ob and htf_trend <= 0

// FVG 필수 체크
if require_fvg
    valid_bull_ob := valid_bull_ob and fvg_bull_recent
    valid_bear_ob := valid_bear_ob and fvg_bear_recent

// BOS/CHoCH 필수 체크
if require_bos_choch
    valid_bull_ob := valid_bull_ob and structure_break_recent
    valid_bear_ob := valid_bear_ob and structure_break_recent

// OB 드로잉 (조건 충족 시에만!)
if show_1h_ob and valid_bull_ob
    box.new(bar_index - 1, high[1], bar_index + ob_extend_bars, low[1], bgcolor=color_1h_ob, border_color=color.yellow, border_width=2)
    label.new(bar_index - 1, low[1], "OB L\n" + str.tostring(confirmation_count) + "개 근거", style=label.style_label_up, color=color.yellow, textcolor=color.black, size=size.small)

if show_1h_ob and valid_bear_ob
    box.new(bar_index - 1, high[1], bar_index + ob_extend_bars, low[1], bgcolor=color_1h_ob, border_color=color.yellow, border_width=2)
    label.new(bar_index - 1, high[1], "OB S\n" + str.tostring(confirmation_count) + "개 근거", style=label.style_label_down, color=color.yellow, textcolor=color.black, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// Liquidity Sweep 감지
// ═══════════════════════════════════════════════════════════════════════════════
var float prev_day_high = na
var float prev_day_low = na

new_day = ta.change(time("D")) != 0
if new_day
    prev_day_high := high[1]
    prev_day_low := low[1]

// BSL Sweep (고점 스윕 후 되돌림)
bsl_sweep = not na(prev_day_high) and high > prev_day_high and close < prev_day_high
// SSL Sweep (저점 스윕 후 되돌림)
ssl_sweep = not na(prev_day_low) and low < prev_day_low and close > prev_day_low

if bsl_sweep
    label.new(bar_index, high, "BSL\nSWEEP", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

if ssl_sweep
    label.new(bar_index, low, "SSL\nSWEEP", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// 인걸핑 캔들 감지
// ═══════════════════════════════════════════════════════════════════════════════
bull_engulfing = close > open and close[1] < open[1] and close > open[1] and open < close[1]
bear_engulfing = close < open and close[1] > open[1] and close < open[1] and open > close[1]

if show_engulfing and bull_engulfing and htf_trend >= 0
    label.new(bar_index, low, "ENG", style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.tiny)

if show_engulfing and bear_engulfing and htf_trend <= 0
    label.new(bar_index, high, "ENG", style=label.style_label_down, color=color.fuchsia, textcolor=color.white, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// 진입 시그널 (모든 조건 충족 시)
// ═══════════════════════════════════════════════════════════════════════════════
long_signal = confirmation_count >= 3 and htf_trend >= 0 and (bull_engulfing or (structure_break_recent and bull_fvg)) and is_killzone
short_signal = confirmation_count >= 3 and htf_trend <= 0 and (bear_engulfing or (structure_break_recent and bear_fvg)) and is_killzone

if show_entry_signal and long_signal
    label.new(bar_index, low, "▲ LONG\n" + str.tostring(confirmation_count) + "개 근거", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.normal)

if show_entry_signal and short_signal
    label.new(bar_index, high, "▼ SHORT\n" + str.tostring(confirmation_count) + "개 근거", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.normal)

// ═══════════════════════════════════════════════════════════════════════════════
// 주요 지지/저항 표시
// ═══════════════════════════════════════════════════════════════════════════════
plot(show_htf_levels ? htf_resistance : na, "HTF Resistance", color=color.new(color.red, 50), linewidth=2, style=plot.style_linebr)
plot(show_htf_levels ? htf_support : na, "HTF Support", color=color.new(color.green, 50), linewidth=2, style=plot.style_linebr)
plot(show_htf_levels ? prev_day_high : na, "Prev Day High", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)
plot(show_htf_levels ? prev_day_low : na, "Prev Day Low", color=color.new(color.orange, 50), linewidth=1, style=plot.style_linebr)

// ═══════════════════════════════════════════════════════════════════════════════
// 상태 테이블
// ═══════════════════════════════════════════════════════════════════════════════
var table info_table = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    // HTF Trend
    table.cell(info_table, 0, 0, "HTF TREND", text_color=color.white, text_size=size.small)
    trend_text = htf_trend == 1 ? "▲ BULL" : htf_trend == -1 ? "▼ BEAR" : "◆ SIDE"
    trend_color = htf_trend == 1 ? color.green : htf_trend == -1 ? color.red : color.gray
    table.cell(info_table, 1, 0, trend_text, text_color=trend_color, text_size=size.small)
    
    // Killzone
    table.cell(info_table, 0, 1, "KILLZONE", text_color=color.white, text_size=size.small)
    kz_text = is_asia ? "A (ASIA)" : is_london ? "M (LONDON)" : is_ny ? "D (NY)" : "OUTSIDE"
    kz_color = is_killzone ? color.yellow : color.gray
    table.cell(info_table, 1, 1, kz_text, text_color=kz_color, text_size=size.small)
    
    // 근거 수
    table.cell(info_table, 0, 2, "CONFIRMATIONS", text_color=color.white, text_size=size.small)
    conf_color = confirmation_count >= 3 ? color.green : confirmation_count >= 2 ? color.yellow : color.red
    table.cell(info_table, 1, 2, str.tostring(confirmation_count) + " / 5", text_color=conf_color, text_size=size.small)
    
    // 유격 (먹을 거리)
    table.cell(info_table, 0, 3, "DISTANCE", text_color=color.white, text_size=size.small)
    table.cell(info_table, 1, 3, str.tostring(distance_percent, "#.##") + "%", text_color=color.aqua, text_size=size.small)
    
    // Structure
    table.cell(info_table, 0, 4, "STRUCTURE", text_color=color.white, text_size=size.small)
    struct_text = structure_break_recent ? "BROKEN" : "INTACT"
    table.cell(info_table, 1, 4, struct_text, text_color=structure_break_recent ? color.lime : color.gray, text_size=size.small)
    
    // FVG
    table.cell(info_table, 0, 5, "FVG", text_color=color.white, text_size=size.small)
    fvg_text = bull_fvg ? "BULL" : bear_fvg ? "BEAR" : "NONE"
    fvg_color = bull_fvg ? color.green : bear_fvg ? color.red : color.gray
    table.cell(info_table, 1, 5, fvg_text, text_color=fvg_color, text_size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// 알림
// ═══════════════════════════════════════════════════════════════════════════════
alertcondition(valid_bull_ob, "Bullish OB Detected", '{"event":"OB_BULL","price":"{{close}}"}')
alertcondition(valid_bear_ob, "Bearish OB Detected", '{"event":"OB_BEAR","price":"{{close}}"}')
alertcondition(long_signal, "Long Entry Signal", '{"signal":"LONG","price":"{{close}}"}')
alertcondition(short_signal, "Short Entry Signal", '{"signal":"SHORT","price":"{{close}}"}')
alertcondition(bsl_sweep, "BSL Sweep", '{"event":"BSL_SWEEP","price":"{{close}}"}')
alertcondition(ssl_sweep, "SSL Sweep", '{"event":"SSL_SWEEP","price":"{{close}}"}')
alertcondition(bos_bull or bos_bear, "BOS Detected", '{"event":"BOS","price":"{{close}}"}')
alertcondition(choch_bull or choch_bear, "CHoCH Detected", '{"event":"CHOCH","price":"{{close}}"}')
alertcondition(bull_fvg or bear_fvg, "FVG Detected", '{"event":"FVG","price":"{{close}}"}')

// ═══════════════════════════════════════════════════════════════════════════════
// END OF INDICATOR - ICT V2 KSH
// ═══════════════════════════════════════════════════════════════════════════════
