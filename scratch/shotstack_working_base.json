                            "width": 1080,
                            "height": 300
                        },
                        "start": 0,
                        "length": 5,
                        "position": "bottom",
                        "offset": {
                            "y": 0.02
                        }
                    }
                ]
            },
            {
                "clips": [
                    {
                        "asset": {
                            "type": "image",
                            "src": "{{SLIDE_1_URL}}"
                        },
                        "start": 0,
                        "length": 5,
                        "fit": "cover",
                        "effect": "zoomIn"
                    }
                ]
            }
        ]
    },
    "output": {
        "format": "mp4",
        "resolution": "hd",
