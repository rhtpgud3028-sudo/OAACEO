## 🔑 주요 명령어 기록

```bash
# Docker 이미지 볼륨 추가 후 재시작
mkdir -p /var/www/images
chmod 777 /var/www/images
docker stop n8n_n8n_1 && docker rm n8n_n8n_1
docker run -d --name n8n_n8n_1 -p 5678:5678 \
  -v /var/www/audio:/var/www/audio \
  -v /var/www/images:/var/www/images \
  -v /root/n8n_data:/home/node/.n8n \
  n8nio/n8n

# Nginx 수정 후 재시작
sudo ln -s /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
sudo nginx -t
sudo systemctl restart nginx
```
