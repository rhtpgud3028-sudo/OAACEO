### 3️⃣ 품질 자동 체크 (수정됨!)

```javascript
// ==================== 품질 체크 (간략화) ====================
const renderResult = $input.first().json;

const qualityCheck = {
    status: renderResult.response?.status || "unknown",
    hasVideo: !!renderResult.response?.data?.url,
    url: renderResult.response?.data?.url || ""
};

// 실패 체크
if (qualityCheck.status !== "done" || !qualityCheck.hasVideo) {
    throw new Error(`🔴 렌더링 실패: ${qualityCheck.status}`);
}

// ⚠️ duration 체크 제거 (별도 API 호출 필요)

return [{ json: { ...renderResult, qualityCheck } }];
```

