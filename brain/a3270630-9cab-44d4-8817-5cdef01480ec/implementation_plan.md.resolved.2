## 🔧 비주얼 클립 시간 수정 (신규!)

```javascript
// 본문 슬라이드 (v20.0: 동적 시간으로 수정!)
for (let i = 0; i < segments.length; i++) {
    const src = images[i] || images[images.length - 1] || placeholderImage;
    const trans = getTransition(i, segments.length, 'slide');

    visualClips.push({
        asset: { type: "image", src },
        // v20.0: 자막과 동일한 동적 시간 사용!
        start: segmentStartTimes[i] || (SUBTITLE_START + i * perSegmentTime),
        length: segmentTimes[i] || perSegmentTime,
        fit: "cover",
        transition: trans
    });
}

// 아웃트로 시작 시간도 동적으로!
const outroStart = segmentStartTimes[segments.length - 1] + segmentTimes[segments.length - 1] || (INTRO_LEN + BODY_LEN);
```

