### 4. 6. Typecast TTS 노드

**Method**: POST
**URL**: https://api.typecast.ai/v1/text-to-speech
**Body Content Type**: JSON

#### Body

```json
{
  "text": {{ (() => { try { let c = $('3. GPT 스크립트').first().json.message.content; if(c.startsWith('```json')) c = c.slice(7); if(c.startsWith('```')) c = c.slice(3); if(c.endsWith('```')) c = c.slice(0,-3); const gpt = JSON.parse(c.trim()); return JSON.stringify(gpt.script || "안녕하세요 여러분 오늘도 건강정보 알려드릴게요"); } catch(e) { return JSON.stringify("안녕하세요 여러분 오늘도 건강정보 알려드릴게요"); } })() }},
  "lang": "ko",
  "voice_id": "tc_5c789c32dabcfa0008b0a38d",
  "model": "ssfm-v21"
}
```

