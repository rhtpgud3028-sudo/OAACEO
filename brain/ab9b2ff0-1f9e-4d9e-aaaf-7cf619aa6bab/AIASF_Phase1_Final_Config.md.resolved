### 2. 5a. Kling 생성 Intro 노드

**Method**: POST
**URL**: https://api.piapi.ai/api/v1/task
**Body Content Type**: JSON

#### Body

```json
{
  "model": "kling",
  "task_type": "video_generation",
  "input": {
    "prompt": {{ (() => { try { let c = $('3. GPT 스크립트').first().json.message.content; if(c.startsWith('```json')) c = c.slice(7); if(c.startsWith('```')) c = c.slice(3); if(c.endsWith('```')) c = c.slice(0,-3); const gpt = JSON.parse(c.trim()); return JSON.stringify(gpt.intro_video_prompt || "A cheerful 58-year-old Korean woman smiling in modern Seoul apartment, soft morning sunlight, iPhone photography"); } catch(e) { return JSON.stringify("A cheerful 58-year-old Korean woman smiling in modern Seoul apartment, soft morning sunlight, iPhone photography"); } })() }},
    "aspect_ratio": "9:16",
    "duration": 5,
    "mode": "std",
    "cfg_scale": 0.5
  }
}
```

---

### 3. 5b. Kling 생성 Outro 노드

**Method**: POST
**URL**: https://api.piapi.ai/api/v1/task
**Body Content Type**: JSON

#### Body

```json
{
  "model": "kling",
  "task_type": "video_generation",
  "input": {
    "prompt": {{ (() => { try { let c = $('3. GPT 스크립트').first().json.message.content; if(c.startsWith('```json')) c = c.slice(7); if(c.startsWith('```')) c = c.slice(3); if(c.endsWith('```')) c = c.slice(0,-3); const gpt = JSON.parse(c.trim()); return JSON.stringify(gpt.outro_video_prompt || "Happy 60-year-old Korean couple giving thumbs up in bright modern apartment, soft natural daylight, iPhone photography"); } catch(e) { return JSON.stringify("Happy 60-year-old Korean couple giving thumbs up in bright modern apartment, soft natural daylight, iPhone photography"); } })() }},
    "aspect_ratio": "9:16",
    "duration": 5,
    "mode": "std",
    "cfg_scale": 0.5
  }
}
```

